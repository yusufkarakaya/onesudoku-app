---
import { APP_STORE_URL, PLAY_STORE_URL } from '../consts';

/**
 * Top navigation for the landing page and the blog.
 *
 * On the landing page the bar is fixed and the section links are in-page
 * anchors; elsewhere those anchors have to point back at `/`, and there is no
 * reason to pin the bar over a long article.
 *
 * The store icons link straight out rather than scrolling to the hero CTAs —
 * one tap to the right store instead of two. They carry `data-store` so the
 * delegated handler in Analytics.astro counts them like every other store link.
 */
interface Props {
  /** `home` pins the bar and uses in-page anchors. */
  variant?: 'home' | 'sub';
}

const { variant = 'home' } = Astro.props;
const isHome = variant === 'home';
const prefix = isHome ? '' : '/';

const stores = [
  {
    href: APP_STORE_URL,
    store: 'ios',
    label: 'Download One Sudoku on the App Store',
    path: 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11',
  },
  {
    href: PLAY_STORE_URL,
    store: 'android',
    label: 'Get One Sudoku on Google Play',
    path: 'M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z',
  },
];
---

<header
  class:list={[
    'z-50 bg-green-950/90 backdrop-blur-sm border-b border-green-800/30',
    isHome ? 'fixed top-0 left-0 right-0' : 'relative',
  ]}
>
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="text-white font-semibold text-lg sm:text-xl tracking-tight shrink-0">
      one sudoku<span class="text-green-400">.</span>
    </a>

    <div class="flex items-center gap-5 sm:gap-6">
      <a href={`${prefix}#how-to-play`} class="hidden sm:inline text-green-200/70 hover:text-white text-sm font-medium transition-colors">How to play</a>
      <a href="/blog/" class="hidden sm:inline text-green-200/70 hover:text-white text-sm font-medium transition-colors">Blog</a>
      <a href={`${prefix}#faq`} class="hidden sm:inline text-green-200/70 hover:text-white text-sm font-medium transition-colors">FAQ</a>

      <div class="flex items-center gap-2 shrink-0">
        {stores.map((store) => (
          <a
            href={store.href}
            target="_blank"
            rel="noopener"
            aria-label={store.label}
            title={store.label}
            data-store={store.store}
            class="grid place-items-center w-11 h-11 rounded-full bg-green-500 hover:bg-green-400 text-green-950 transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={store.path}/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>
