---
/**
 * The landing page, in any language. `src/pages/index.astro` renders it in
 * English and `src/pages/[lang]/index.astro` in every other language; the copy
 * lives in `src/i18n/home.ts`.
 */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE_URL, APP_STORE_URL } from '../consts';
import { everyLanguage, localizePath, playStoreUrl, t, type Lang } from '../i18n/ui';
import { home } from '../i18n/home';
import { localizedPostPath } from '../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang];
const s = t(lang);
const alternates = everyLanguage('/');
const pageUrl = `${SITE_URL}${localizePath('/', lang)}`;
const playUrl = playStoreUrl(lang);
const learnGuide = await localizedPostPath('learn-sudoku', lang);
const manorGuide = await localizedPostPath('haunted-manor-ghost-puzzle', lang);

// Real app screenshots. Drives both the gallery below and SoftwareApplication.screenshot,
// so the alt text a reader gets and the schema a crawler gets can never diverge.
// home.webp is produced by `npm run generate:images` — do not hand-edit it.
const screenshots = [{ src: '/screenshots/home.webp', alt: c.screenshotAlt }];

// --- Structured data (GEO / rich results) ---
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'One Sudoku',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'GameApplication',
  url: pageUrl,
  inLanguage: lang,
  downloadUrl: [APP_STORE_URL, playUrl],
  installUrl: [APP_STORE_URL, playUrl],
  description: c.schema.description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  screenshot: screenshots.map((shot) => ({
    '@type': 'ImageObject',
    contentUrl: `${SITE_URL}${shot.src}`,
    description: shot.alt,
  })),
  featureList: c.schema.features,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'One Sudoku',
  url: SITE_URL,
  inLanguage: lang,
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'One Sudoku',
    url: SITE_URL,
    logo: `${SITE_URL}/logo-512.png`,
    // Lets search and answer engines tie the site and the store listings to one entity.
    sameAs: [APP_STORE_URL, playStoreUrl('en')],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: c.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Illustrative mini grid for the "How to play" section
const howToSeed: Record<number, number> = {
  0: 5, 4: 3, 7: 8, 11: 1, 15: 4, 20: 8, 27: 4, 30: 7, 35: 9,
  40: 5, 44: 3, 50: 2, 53: 6, 57: 3, 61: 4, 65: 8, 69: 1, 76: 6, 80: 4,
};
const howToCells = Array.from({ length: 81 }, (_, i) => {
  const row = Math.floor(i / 9);
  const col = i % 9;
  const num = howToSeed[i];
  const cls = [
    'flex items-center justify-center text-xs sm:text-sm font-semibold bg-white',
    col === 2 || col === 5 ? 'border-r-2 border-r-green-300' : '',
    row === 2 || row === 5 ? 'border-b-2 border-b-green-300' : '',
    num ? 'text-green-700' : 'text-transparent',
  ].filter(Boolean).join(' ');
  return { num, cls };
});

// Illustrative 6×6 manor for the Haunted Manor section, in the app's night
// palette (src/theme/manor.ts in the app repo). It is a real solution: one ghost
// per row, column and room, and no two ghosts touching.
const manorRoomColors = ['#6F60A3', '#AF6D3E', '#5C8A6A', '#5073A9', '#9E6180', '#498D94'];
const manorRooms = [
  [0, 0, 0, 1, 1, 2],
  [0, 0, 1, 1, 2, 2],
  [3, 0, 4, 1, 2, 2],
  [3, 3, 4, 4, 5, 2],
  [3, 4, 4, 5, 5, 5],
  [3, 3, 4, 5, 5, 5],
];
const manorGhostCol = [1, 3, 5, 0, 2, 4];
const manorCells = manorRooms.flatMap((row, r) =>
  row.map((room, c) => ({ color: manorRoomColors[room], ghost: manorGhostCol[r] === c })),
);
---

<Layout title={c.meta.title} description={c.meta.description} lang={lang} alternates={alternates}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <Header variant="home" lang={lang} alternates={alternates} />

  <!-- Hero -->
  <section class="bg-green-950 pt-28 pb-16 sm:pt-32 sm:pb-24 px-6 overflow-hidden relative">
    <div class="absolute inset-0 opacity-5" aria-hidden="true" style="background-image: repeating-linear-gradient(0deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px);"></div>

    <div class="max-w-5xl mx-auto relative flex flex-col lg:flex-row items-center lg:justify-between gap-12">
      <div class="max-w-2xl text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-green-900/60 border border-green-700/40 rounded-full px-4 py-1.5 mb-6 sm:mb-8">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-green-300 text-xs sm:text-sm font-medium">{c.hero.badge}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white leading-[1.05] mb-5 sm:mb-6">
          {c.hero.headline}<br/>
          <span class="text-green-400">{c.hero.headlineAccent}</span>
        </h1>

        <p class="text-green-200/70 text-lg md:text-xl leading-relaxed mb-8 sm:mb-10 max-w-xl mx-auto lg:mx-0">
          {c.hero.body}
        </p>

        <div id="download" class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center lg:justify-start gap-4 scroll-mt-24">
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener"
            aria-label={s.store.appStoreAria}
            data-store="ios"
            class="w-full sm:w-auto inline-flex items-center justify-center sm:justify-start gap-3 bg-white hover:bg-green-50 text-green-950 font-semibold px-6 py-3.5 rounded-2xl transition-colors shadow-lg shadow-green-950/40"
          >
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
            </svg>
            <span class="text-left">
              <span class="block text-xs text-green-800/60 leading-none mb-0.5">{s.store.downloadOnThe}</span>
              <span class="block text-base leading-none">App Store</span>
            </span>
          </a>
          <a
            href={playUrl}
            target="_blank"
            rel="noopener"
            aria-label={s.store.playAria}
            data-store="android"
            class="w-full sm:w-auto inline-flex items-center justify-center sm:justify-start gap-3 bg-white hover:bg-green-50 text-green-950 font-semibold px-6 py-3.5 rounded-2xl transition-colors shadow-lg shadow-green-950/40"
          >
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
            </svg>
            <span class="text-left">
              <span class="block text-xs text-green-800/60 leading-none mb-0.5">{s.store.getItOn}</span>
              <span class="block text-base leading-none">Google Play</span>
            </span>
          </a>
          <span class="text-green-300/70 text-sm font-medium">{s.store.free}</span>
          {s.appLanguageNote && <span class="w-full text-center lg:text-left text-green-300/60 text-sm">{s.appLanguageNote}</span>}
        </div>
      </div>

      <!-- Real home screen, cropped out of the App Store artwork -->
      <img
        src="/screenshots/home.webp"
        alt={c.screenshotAlt}
        width="720"
        height="1516"
        fetchpriority="high"
        decoding="async"
        class="w-56 sm:w-64 lg:w-72 shrink-0 drop-shadow-2xl"
      />
    </div>
  </section>

  <!-- Trust row -->
  <section class="bg-green-900 px-6 py-8 sm:py-10 border-t border-green-800/40">
    <ul class="max-w-5xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-7">
      {c.trust.map((point) => (
        <li class="flex gap-3">
          <svg class="w-5 h-5 text-green-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          <div>
            <p class="text-white font-semibold text-sm leading-snug">{point.label}</p>
            <p class="text-green-300/60 text-xs sm:text-sm leading-snug mt-0.5">{point.sub}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Haunted Manor: the Halloween game on the Play hub -->
  <section class="bg-[#17142A] py-16 sm:py-24 px-6 overflow-hidden">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 bg-[#F28C28]/15 border border-[#F28C28]/40 rounded-full px-4 py-1.5 mb-6 text-[#F28C28] text-xs sm:text-sm font-semibold">
          <span class="w-2 h-2 bg-[#F28C28] rounded-full animate-pulse"></span>
          {c.manor.badge}
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#EEE8F6] mb-4">{c.manor.title}</h2>
        <p class="text-[#B8B0D2] text-lg leading-relaxed mb-6 max-w-xl mx-auto lg:mx-0">
          {c.manor.body}
        </p>
        <ul class="space-y-3 text-[#DDD5EC] text-left max-w-md mx-auto lg:mx-0">
          {c.manor.points.map((point) => (
            <li class="flex gap-3"><span class="text-[#F28C28] font-bold" aria-hidden="true">✓</span>{point}</li>
          ))}
        </ul>
        <a href={manorGuide} class="inline-flex items-center gap-2 mt-8 text-[#F28C28] hover:text-[#F5A65B] font-semibold transition-colors">
          {c.manor.link}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mx-auto w-full max-w-xs sm:max-w-sm" role="img" aria-label={c.manor.gridLabel}>
        <div class="grid grid-cols-6 gap-1 p-2 rounded-3xl bg-[#0F0D1C] shadow-2xl shadow-black/40">
          {manorCells.map((cell) => (
            <div class="aspect-square rounded-md flex items-center justify-center" style={`background-color: ${cell.color}`}>
              {cell.ghost && (
                <svg class="w-3/5 h-3/5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#F4EEF8" d="M12 2a8 8 0 0 0-8 8v11.5l2.7-2 2.6 2 2.7-2 2.7 2 2.6-2 2.7 2V10a8 8 0 0 0-8-8z"/>
                  <circle cx="9.3" cy="10.5" r="1.4" fill="#17142A"/>
                  <circle cx="14.7" cy="10.5" r="1.4" fill="#17142A"/>
                </svg>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-green-50 py-16 sm:py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-4">{c.features.title}</h2>
        <p class="text-zinc-500 text-lg max-w-xl mx-auto">{c.features.sub}</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Classic Rules -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="14" y="3" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="3" y="14" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="14" y="14" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">{c.features.items[0].title}</h3>
          <p class="text-zinc-500 leading-relaxed">{c.features.items[0].body}</p>
        </div>

        <!-- Daily Challenge -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">{c.features.items[1].title}</h3>
          <p class="text-zinc-500 leading-relaxed">{c.features.items[1].body}</p>
        </div>

        <!-- Clean Design -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">{c.features.items[2].title}</h3>
          <p class="text-zinc-500 leading-relaxed">{c.features.items[2].body}</p>
        </div>

        <!-- Offline -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-4.9-6H7a4 4 0 00-4 4z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">{c.features.items[3].title}</h3>
          <p class="text-zinc-500 leading-relaxed">{c.features.items[3].body}</p>
        </div>

        <!-- Smart Tools -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">{c.features.items[4].title}</h3>
          <p class="text-zinc-500 leading-relaxed">{c.features.items[4].body}</p>
        </div>

        <!-- Stats -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9m6 10V5m6 14v-7"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">{c.features.items[5].title}</h3>
          <p class="text-zinc-500 leading-relaxed">{c.features.items[5].body}</p>
        </div>

      </div>
    </div>
  </section>

  <!-- A look inside -->
  <section class="bg-white py-16 sm:py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-4">{c.inside.title}</h2>
        <p class="text-zinc-500 text-lg max-w-xl mx-auto">{c.inside.sub}</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="justify-self-center lg:justify-self-end">
          <img
            src={screenshots[0].src}
            alt={c.screenshotAlt}
            width="720"
            height="1516"
            loading="lazy"
            decoding="async"
            class="w-60 sm:w-72 drop-shadow-2xl"
          />
        </div>

        <ul class="space-y-6 max-w-md">
          {c.inside.points.map((point) => (
            <li class="flex gap-4">
              <span class="shrink-0 w-9 h-9 rounded-xl bg-green-100 grid place-items-center">
                <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              <div>
                <h3 class="text-lg font-semibold text-green-950 mb-1">{point.title}</h3>
                <p class="text-zinc-500 leading-relaxed">{point.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How to Play -->
  <section id="how-to-play" class="bg-white pb-16 sm:pb-24 px-6 scroll-mt-20">
    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="text-green-600 font-semibold text-sm tracking-wide uppercase mb-3">{c.howTo.eyebrow}</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-5">{c.howTo.title}</h2>
          <p class="text-zinc-500 text-lg leading-relaxed mb-8">
            {c.howTo.body}
          </p>
          <ol class="space-y-5">
            {c.howTo.rules.map((rule, i) => (
              <li class="flex gap-4">
                <span class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-700 font-semibold grid place-items-center">{i + 1}</span>
                <p class="text-zinc-600 leading-relaxed pt-1" set:html={rule} />
              </li>
            ))}
          </ol>
          <p class="mt-8">
            <a href={learnGuide} class="inline-flex items-center gap-2 text-green-700 hover:text-green-600 font-semibold transition-colors">
              {c.howTo.link}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </p>
        </div>

        <!-- mini illustrative grid -->
        <div class="justify-self-center w-full max-w-72" aria-hidden="true">
          <div class="w-full aspect-square p-2 bg-green-50 rounded-2xl border border-green-100 grid grid-cols-9 gap-px">
            {howToCells.map(({ num, cls }) => (
              <div class={cls}>{num || '0'}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-green-50 py-16 sm:py-24 px-6 scroll-mt-20">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-4">{c.faq.title}</h2>
        <p class="text-zinc-500 text-lg">{c.faq.sub}</p>
      </div>

      <div class="space-y-3">
        {c.faq.items.map((f) => (
          <details class="group bg-white rounded-2xl border border-green-100 open:border-green-300 transition-colors">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 sm:px-6 py-5 text-green-950 font-semibold">
              {f.q}
              <svg class="w-5 h-5 text-green-500 shrink-0 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
              </svg>
            </summary>
            <p class="px-5 sm:px-6 pb-5 -mt-1 text-zinc-500 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-green-900 py-16 sm:py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-5">{c.finalCta.title}</h2>
      <p class="text-green-200/70 text-lg mb-8 sm:mb-10">{c.finalCta.body}</p>
      <div class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-4">
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener"
          aria-label={s.store.appStoreAria}
          data-store="ios"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl text-lg transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
          </svg>
          App Store
        </a>
        <a
          href={playUrl}
          target="_blank"
          rel="noopener"
          aria-label={s.store.playAria}
          data-store="android"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl text-lg transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
          </svg>
          Google Play
        </a>
      </div>
    </div>
  </section>

  <Footer active="home" lang={lang} alternates={alternates} />

  <!-- Persistent download prompt on phones, where the hero CTAs scroll away fast.
       Sends people to the hero's store buttons rather than guessing their platform. -->
  <div class="sm:hidden h-20" aria-hidden="true"></div>
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-green-950/95 backdrop-blur-sm border-t border-green-800/50 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] flex items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-white font-semibold text-sm leading-tight">One Sudoku</p>
      <p class="text-green-300/70 text-xs leading-tight">{s.store.free}</p>
    </div>
    <a href="#download" class="shrink-0 bg-green-500 hover:bg-green-400 text-green-950 font-semibold text-sm px-5 py-2.5 rounded-full transition-colors">
      {s.store.download}
    </a>
  </div>
</Layout>
