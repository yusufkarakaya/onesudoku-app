---
/**
 * "On this page" for an article, built from its h2s.
 *
 * Rendered twice by the post page: a collapsible block above the article on
 * small screens, and a sticky sidebar on large ones. The sidebar highlights the
 * section being read; the script below is shared by both and harmless for the
 * one that is hidden.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'mobile' | 'sidebar';
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2);

const linkClass =
  'block py-1.5 text-zinc-500 hover:text-green-800 transition-colors leading-snug ' +
  'data-[active=true]:text-green-800 data-[active=true]:font-semibold';
---

{variant === 'mobile' ? (
  <details class="group lg:hidden mb-10 rounded-2xl border border-green-100 bg-green-50/60">
    <summary class="flex items-center justify-between cursor-pointer list-none px-5 py-4 font-semibold text-green-950 [&::-webkit-details-marker]:hidden">
      On this page
      <svg class="w-4 h-4 text-green-700 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
    </summary>
    <ol class="px-5 pb-4 text-[0.95rem]">
      {items.map((h) => <li><a href={`#${h.slug}`} class={linkClass} data-toc-link={h.slug}>{h.text}</a></li>)}
    </ol>
  </details>
) : (
  <nav aria-label="On this page" class="hidden lg:block sticky top-10 text-sm">
    <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-3">On this page</p>
    <ol class="border-l border-green-100">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class={`${linkClass} -ml-px pl-4 border-l-2 border-transparent data-[active=true]:border-green-500`}
            data-toc-link={h.slug}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Marks the TOC entry for the last h2 that has scrolled past the top third
  // of the viewport. Runs once even though the component renders twice.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  const headings = [...new Set([...links].map((a) => a.dataset.tocLink!))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (headings.length > 0) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.33;
      let current = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= line) current = h.id;
      }
      links.forEach((a) => (a.dataset.active = String(a.dataset.tocLink === current)));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
