---
/**
 * The single call to action at the end of every post and of the blog index.
 *
 * Both buttons go straight to the stores. They keep `data-store` so
 * Analytics.astro counts them like every other store link.
 */
import { APP_STORE_URL, PLAY_STORE_URL } from '../../consts';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Play your first puzzle',
  body = 'One Sudoku is free on iPhone, iPad and Android. No account, works offline. Start on Easy and move up whenever you’re ready.',
} = Astro.props;

// Decorative grid: a few givens (no row, column or box repeats) and one
// highlighted cell, the move just made.
const givens: Record<number, number> = {
  0: 5, 2: 4, 4: 6, 7: 9, 10: 8, 12: 3, 14: 1, 16: 2,
  19: 6, 21: 9, 25: 4, 27: 1, 30: 5, 33: 8, 35: 6,
  45: 3, 47: 2, 50: 4, 53: 9, 55: 4, 59: 6, 61: 5,
  64: 9, 66: 1, 68: 5, 70: 3, 73: 7, 76: 8, 78: 2, 80: 1,
};
const highlight = 40;
// Grouped by box so the thicker 3×3 boundaries come from the outer gap.
const boxes = Array.from({ length: 9 }, (_, box) =>
  Array.from({ length: 9 }, (_, k) => {
    const i = (Math.floor(box / 3) * 3 + Math.floor(k / 3)) * 9 + (box % 3) * 3 + (k % 3);
    return { value: i === highlight ? 7 : givens[i], hot: i === highlight };
  }),
);

const stores = [
  {
    href: APP_STORE_URL,
    store: 'ios',
    label: 'App Store',
    aria: 'Download One Sudoku on the App Store',
    path: 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11',
  },
  {
    href: PLAY_STORE_URL,
    store: 'android',
    label: 'Google Play',
    aria: 'Get One Sudoku on Google Play',
    path: 'M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z',
  },
];
---

<section class="relative overflow-hidden rounded-3xl bg-green-950 px-6 py-10 sm:px-10 sm:py-14 lg:px-14">
  <div
    class="absolute inset-0 opacity-[0.06]"
    aria-hidden="true"
    style="background-image: repeating-linear-gradient(0deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px);"
  />
  <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-green-500/20 blur-3xl" aria-hidden="true" />

  <div class="relative grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
    <div>
      <span class="inline-flex items-center gap-2 bg-green-900/60 border border-green-700/40 rounded-full px-3 py-1 text-green-300 text-xs font-semibold mb-5">
        <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
        Put it into practice
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight text-balance mb-4">{title}</h2>
      <p class="text-green-100/75 text-lg leading-relaxed max-w-md mb-8 text-pretty">{body}</p>

      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3">
        {stores.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            aria-label={s.aria}
            data-store={s.store}
            class="inline-flex items-center justify-center gap-2.5 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-6 py-3.5 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path}/></svg>
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <div class="hidden md:block w-60 lg:w-64" aria-hidden="true">
      <div class="grid grid-cols-3 gap-1 p-2 rounded-2xl bg-green-800/60 border border-green-700/50 shadow-2xl shadow-black/30 rotate-2">
        {boxes.map((cells) => (
          <div class="grid grid-cols-3 gap-px">
            {cells.map((c) => (
              <div
                class:list={[
                  'aspect-square flex items-center justify-center text-[11px] font-semibold rounded-[3px]',
                  c.hot ? 'bg-green-400 text-green-950 shadow-[0_0_18px_rgba(74,222,128,0.6)]' : 'bg-green-950 text-green-300/80',
                ]}
              >
                {c.value ?? ''}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
