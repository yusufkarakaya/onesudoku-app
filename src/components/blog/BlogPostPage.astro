---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
/**
 * One blog post, in whatever language it is written in. Rendered by
 * `src/pages/blog/[...slug].astro` (English) and
 * `src/pages/[lang]/blog/[...slug].astro` (translations).
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PostCard from './PostCard.astro';
import TableOfContents from './TableOfContents.astro';
import BlogCta from './BlogCta.astro';
import { SITE_URL } from '../../consts';
import { getPosts, postLang, postPath, translationsOf, type Post } from '../../lib/blog';
import { categoryLabel, formatDate, localizePath, t } from '../../i18n/ui';
import { getCollection } from 'astro:content';

type Props = { post: Post };

const { post } = Astro.props;
const lang = postLang(post);
const s = t(lang);
const posts = await getPosts(lang);
const alternates = translationsOf(post, await getCollection('blog'));
const blogPath = localizePath('/blog/', lang);
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, readingTime, category, heroImage, heroAlt, heroCredit, heroCreditUrl } =
  post.data;

const url = `${SITE_URL}${postPath(post)}`;
// Same category first: a technique page should lead to the next technique.
const others = posts.filter((p) => p.id !== post.id);
const related = [
  ...others.filter((p) => p.data.category === category),
  ...others.filter((p) => p.data.category !== category),
].slice(0, 2);
// A sidebar for two headings is more chrome than help.
const showToc = headings.filter((h) => h.depth === 2).length >= 3;

// Structured data wants a crawlable JPEG, not the responsive webp set.
const schemaImage = heroImage
  ? new URL((await getImage({ src: heroImage, width: 1200, format: 'jpg' })).src, SITE_URL).href
  : `${SITE_URL}/og-image.png`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: schemaImage,
  author: { '@type': 'Organization', name: 'yukabuild', url: 'https://yukabuild.com' },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'One Sudoku',
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo-512.png` },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'One Sudoku', item: `${SITE_URL}${localizePath('/', lang)}` },
    { '@type': 'ListItem', position: 2, name: s.blog.breadcrumb, item: `${SITE_URL}${blogPath}` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};

const shareOnX = `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
---

<Layout title={`${title} — One Sudoku`} description={description} lang={lang} alternates={alternates}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <div
    id="read-progress"
    class="fixed top-0 left-0 right-0 h-[3px] z-[60] bg-green-400 origin-left scale-x-0"
    aria-hidden="true"
  />

  <Header variant="sub" lang={lang} alternates={alternates} />

  <main class="bg-white">
    <article>
      <header class:list={['relative overflow-hidden bg-green-950 px-6 pt-12 sm:pt-16', heroImage ? 'pb-36 sm:pb-48' : 'pb-14 sm:pb-20']}>
        <div
          class="absolute inset-0 opacity-5"
          aria-hidden="true"
          style="background-image: repeating-linear-gradient(0deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px);"
        />
        <div class="relative max-w-3xl mx-auto text-center">
          <nav aria-label="Breadcrumb" class="mb-8">
            <ol class="inline-flex items-center gap-2 text-sm font-medium">
              <li><a href={blogPath} class="text-green-300/80 hover:text-white transition-colors">{s.blog.breadcrumb}</a></li>
              {category && (
                <>
                  <li aria-hidden="true" class="text-green-700">/</li>
                  <li class="text-green-400">{categoryLabel(category, lang)}</li>
                </>
              )}
            </ol>
          </nav>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.08] text-balance mb-6">{title}</h1>
          <p class="text-lg sm:text-xl text-green-100/75 leading-relaxed text-pretty max-w-2xl mx-auto mb-9">{description}</p>

          <div class="inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-green-200/80">
            <a href="https://yukabuild.com" target="_blank" rel="noopener" class="font-medium text-white underline decoration-green-500/60 underline-offset-4 hover:decoration-green-400 transition-colors">yukabuild</a>
            <span aria-hidden="true" class="text-green-700">•</span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
            {readingTime && (
              <>
                <span aria-hidden="true" class="text-green-700">•</span>
                <span>{s.blog.minRead(readingTime)}</span>
              </>
            )}
            {updatedDate && (
              <>
                <span aria-hidden="true" class="text-green-700">•</span>
                <span>{s.blog.updated} {formatDate(updatedDate, lang)}</span>
              </>
            )}
          </div>
        </div>
      </header>

      {heroImage && (
        <figure class="relative px-6 -mt-28 sm:-mt-36 max-w-5xl mx-auto">
          <Image
            src={heroImage}
            alt={heroAlt ?? ''}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(min-width: 1072px) 1024px, calc(100vw - 48px)"
            loading="eager"
            fetchpriority="high"
            class="w-full aspect-[16/9] object-cover rounded-3xl shadow-2xl shadow-green-950/20 ring-1 ring-black/5"
          />
          {heroCredit && (
            <figcaption class="mt-3 text-xs text-zinc-400 text-right">
              {s.blog.photo} {heroCreditUrl ? (
                <a href={heroCreditUrl} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-zinc-600">{heroCredit}</a>
              ) : heroCredit}
            </figcaption>
          )}
        </figure>
      )}

      <div class="px-6 pt-12 sm:pt-16 pb-16 sm:pb-20">
        <div class:list={['mx-auto', showToc ? 'max-w-5xl lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16' : 'max-w-[44rem]']}>
          <div class="min-w-0 max-w-[44rem]">
            {showToc && <TableOfContents headings={headings} variant="mobile" />}

            <div id="post-body" class="post-body prose prose-lg max-w-none prose-headings:font-bold prose-h2:text-[1.75rem] sm:prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5 prose-li:my-1.5">
              <Content />
            </div>

            <div class="mt-14 pt-8 border-t border-green-100 flex flex-wrap items-center justify-between gap-4">
              <p class="text-sm font-semibold text-green-950">{s.blog.sharePrompt}</p>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="share-native"
                  hidden
                  class="inline-flex items-center gap-2 h-10 px-4 rounded-xl border border-green-200 text-sm font-medium text-green-900 hover:bg-green-50 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12v7a2 2 0 002 2h12a2 2 0 002-2v-7M16 6l-4-4-4 4M12 2v14"/></svg>
                  {s.blog.share}
                </button>
                <button
                  type="button"
                  id="share-copy"
                  data-url={url}
                  data-copy={s.blog.copyLink}
                  data-copied={s.blog.copied}
                  data-failed={s.blog.copyFailed}
                  class="inline-flex items-center gap-2 h-10 px-4 rounded-xl border border-green-200 text-sm font-medium text-green-900 hover:bg-green-50 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07l-1.5 1.5M14 10a5 5 0 00-7.07 0l-3 3a5 5 0 007.07 7.07l1.5-1.5"/></svg>
                  <span data-label>{s.blog.copyLink}</span>
                </button>
                <a
                  href={shareOnX}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.blog.shareOnX}
                  class="grid place-items-center w-10 h-10 rounded-xl border border-green-200 text-green-900 hover:bg-green-50 transition-colors"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              </div>
            </div>
          </div>

          {showToc && (
            <aside class="hidden lg:block">
              <TableOfContents headings={headings} variant="sidebar" />
            </aside>
          )}
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="bg-green-50/60 border-t border-green-100 px-6 py-14 sm:py-20">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-end justify-between gap-4 mb-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-green-950 tracking-tight">{s.blog.keepReading}</h2>
            <a href={blogPath} class="text-sm font-semibold text-green-700 hover:text-green-600 shrink-0">{s.blog.allPosts}</a>
          </div>
          {related.length === 1 ? (
            <PostCard post={related[0]} variant="featured" headingLevel="h3" />
          ) : (
            <div class="grid gap-6 sm:grid-cols-2">
              {related.map((p) => <PostCard post={p} headingLevel="h3" />)}
            </div>
          )}
        </div>
      </section>
    )}

    <section class:list={['px-6 pb-16 sm:pb-24', related.length > 0 ? 'bg-green-50/60' : 'pt-4']}>
      <div class="max-w-5xl mx-auto">
        <BlogCta lang={lang} />
      </div>
    </section>
  </main>

  <Footer active="blog" lang={lang} alternates={alternates} />
</Layout>

<script>
  // Reading progress: how far through the article body the reader is.
  const bar = document.getElementById('read-progress');
  const body = document.getElementById('post-body');
  if (bar && body) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight * 0.6;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  // "#" anchors on h2s, so a section can be linked to directly.
  body?.querySelectorAll<HTMLHeadingElement>('h2[id]').forEach((h) => {
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.setAttribute('aria-label', `Link to “${h.textContent}”`);
    a.textContent = '#';
    h.append(a);
  });

  // Copy link, with native share where the platform offers it.
  const copy = document.getElementById('share-copy');
  copy?.addEventListener('click', async () => {
    const label = copy.querySelector('[data-label]');
    try {
      await navigator.clipboard.writeText(copy.dataset.url ?? location.href);
      if (label) label.textContent = copy.dataset.copied ?? 'Copied!';
    } catch {
      if (label) label.textContent = copy.dataset.failed ?? 'Copy failed';
    }
    setTimeout(() => label && (label.textContent = copy.dataset.copy ?? 'Copy link'), 2000);
  });

  const native = document.getElementById('share-native');
  if (native && 'share' in navigator) {
    native.hidden = false;
    native.addEventListener('click', () => {
      navigator.share({ title: document.title, url: copy?.dataset.url ?? location.href }).catch(() => {});
    });
  }
</script>
