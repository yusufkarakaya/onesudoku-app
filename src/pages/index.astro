---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, APP_STORE_URL, PLAY_STORE_URL } from '../consts';

// Single source of truth: drives both the visible FAQ accordion and the FAQPage schema.
const faqs = [
  {
    q: 'Is One Sudoku free?',
    a: 'Yes. One Sudoku is free to download and play with minimal, non-intrusive ads. No account required.',
  },
  {
    q: 'Does it work offline?',
    a: 'Completely. Puzzles are generated on your device, so you can play anywhere — on a plane, on the subway, or with no signal at all. No internet connection is ever needed.',
  },
  {
    q: 'What game modes are there?',
    a: 'Three kinds of sudoku: Classic, Killer, where cages with sums replace the given numbers, and Rescue, where you take over a badly solved puzzle and fix it. Alongside them is Haunted Manor, a Halloween logic puzzle in which you hide one ghost on every floor, in every hall and in every room, with no two ghosts touching.',
  },
  {
    q: 'What difficulty levels are there?',
    a: 'Classic has four difficulty levels — Easy, Medium, Hard, and Expert — so it works for both newcomers and experienced solvers. Killer and Rescue have their own levels, and Haunted Manor comes in three sizes: Cottage, Manor, and Castle.',
  },
  {
    q: 'What is the Daily Challenge?',
    a: 'Every day there is one fresh puzzle that is the same for every player worldwide. Solve it each day to build and keep your streak.',
  },
  {
    q: 'Are there any ads or in-app purchases?',
    a: 'One Sudoku shows minimal banner ads to keep the app free, and you can watch optional video ads to earn extra hints. If you would rather play ad-free, the optional Premium removes every ad for $1.99 a month, $11.99 a year, or $29.99 once.',
  },
  {
    q: 'Is One Sudoku available on Android?',
    a: 'Yes. One Sudoku is available on the App Store for iPhone and iPad, and on Google Play for Android phones and tablets.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. You can play everything as a guest, and your progress is saved on your device. Signing in with Google, Apple, or an email address is optional — it syncs your progress and streaks across your devices so nothing is lost when you switch phones.',
  },
];

// Real app screenshots. Drives both the gallery below and SoftwareApplication.screenshot,
// so the alt text a reader gets and the schema a crawler gets can never diverge.
// home.webp is produced by `npm run generate:images` — do not hand-edit it.
const screenshots = [
  {
    src: '/screenshots/home.webp',
    alt: 'The One Sudoku home screen on iPhone, showing a game in progress, the Classic, Rescue and Killer play modes, and the daily challenge streak.',
  },
];

// --- Structured data (GEO / rich results) ---
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'One Sudoku',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'GameApplication',
  url: SITE_URL,
  downloadUrl: [APP_STORE_URL, PLAY_STORE_URL],
  installUrl: [APP_STORE_URL, PLAY_STORE_URL],
  description:
    'A clean, free sudoku game for iPhone, iPad, and Android with Classic, Killer, and Rescue modes, the Haunted Manor Halloween puzzle, a daily challenge, smart notes, and unlimited offline puzzles.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  screenshot: screenshots.map((shot) => ({
    '@type': 'ImageObject',
    contentUrl: `${SITE_URL}${shot.src}`,
    description: shot.alt,
  })),
  featureList: [
    'Classic sudoku with four difficulty levels (Easy, Medium, Hard, Expert)',
    'Killer sudoku and Rescue mode',
    'Haunted Manor, a Halloween ghost-placing logic puzzle',
    'Daily challenge with streaks',
    'Unlimited offline puzzles',
    'Candidate notes, unlimited undo, auto-save',
    'Optional cloud sync with Google, Apple, or email sign-in',
    'Free to play, light and dark themes',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'One Sudoku',
  url: SITE_URL,
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'One Sudoku',
    url: SITE_URL,
    logo: `${SITE_URL}/logo-512.png`,
    // Lets search and answer engines tie the site and the store listings to one entity.
    sameAs: [APP_STORE_URL, PLAY_STORE_URL],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Trust row under the hero. Every claim here is one a visitor can verify from
// the store listing or by opening the app — no invented ratings or download
// counts, which would also put the structured data at risk.
const trustPoints = [
  { label: 'Free to play', sub: 'Optional ad-free Premium' },
  { label: 'No account needed', sub: 'Open it and start solving' },
  { label: 'Works fully offline', sub: 'Puzzles made on your device' },
  { label: 'iPhone, iPad & Android', sub: 'Same app on every screen' },
];

// Claims paired with the screenshot in "A look inside".
const insidePoints = [
  { title: 'Three ways to play', body: 'Classic from Easy to Expert, Killer with its sum cages, and Rescue, where you save a puzzle someone else got wrong.' },
  { title: 'Pick up where you left off', body: 'Every puzzle auto-saves, so a game survives the phone going in your pocket.' },
  { title: 'A daily challenge', body: 'One shared puzzle a day, with a streak that only grows if you keep showing up.' },
  { title: 'Nothing you did not ask for', body: 'No pop-ups, no forced sign-up, no feed to scroll. Just the grid.' },
];

// Illustrative mini grid for the "How to play" section
const howToSeed: Record<number, number> = {
  0: 5, 4: 3, 7: 8, 11: 1, 15: 4, 20: 8, 27: 4, 30: 7, 35: 9,
  40: 5, 44: 3, 50: 2, 53: 6, 57: 3, 61: 4, 65: 8, 69: 1, 76: 6, 80: 4,
};
const howToCells = Array.from({ length: 81 }, (_, i) => {
  const row = Math.floor(i / 9);
  const col = i % 9;
  const num = howToSeed[i];
  const cls = [
    'flex items-center justify-center text-xs sm:text-sm font-semibold bg-white',
    col === 2 || col === 5 ? 'border-r-2 border-r-green-300' : '',
    row === 2 || row === 5 ? 'border-b-2 border-b-green-300' : '',
    num ? 'text-green-700' : 'text-transparent',
  ].filter(Boolean).join(' ');
  return { num, cls };
});

// Illustrative 6×6 manor for the Haunted Manor section, in the app's night
// palette (src/theme/manor.ts in the app repo). It is a real solution: one ghost
// per row, column and room, and no two ghosts touching.
const manorRoomColors = ['#6F60A3', '#AF6D3E', '#5C8A6A', '#5073A9', '#9E6180', '#498D94'];
const manorRooms = [
  [0, 0, 0, 1, 1, 2],
  [0, 0, 1, 1, 2, 2],
  [3, 0, 4, 1, 2, 2],
  [3, 3, 4, 4, 5, 2],
  [3, 4, 4, 5, 5, 5],
  [3, 3, 4, 5, 5, 5],
];
const manorGhostCol = [1, 3, 5, 0, 2, 4];
const manorCells = manorRooms.flatMap((row, r) =>
  row.map((room, c) => ({ color: manorRoomColors[room], ghost: manorGhostCol[r] === c })),
);
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <Header variant="home" />

  <!-- Hero -->
  <section class="bg-green-950 pt-28 pb-16 sm:pt-32 sm:pb-24 px-6 overflow-hidden relative">
    <div class="absolute inset-0 opacity-5" aria-hidden="true" style="background-image: repeating-linear-gradient(0deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px);"></div>

    <div class="max-w-5xl mx-auto relative flex flex-col lg:flex-row items-center lg:justify-between gap-12">
      <div class="max-w-2xl text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-green-900/60 border border-green-700/40 rounded-full px-4 py-1.5 mb-6 sm:mb-8">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-green-300 text-xs sm:text-sm font-medium">Available on the App Store &amp; Google Play</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white leading-[1.05] mb-5 sm:mb-6">
          Sudoku.<br/>
          <span class="text-green-400">Pure and simple.</span>
        </h1>

        <p class="text-green-200/70 text-lg md:text-xl leading-relaxed mb-8 sm:mb-10 max-w-xl mx-auto lg:mx-0">
          A few quiet minutes with one puzzle and nothing else competing for your attention. Classic, Killer, and Rescue sudoku, a daily challenge, and unlimited offline puzzles — free, with no account and no clutter.
        </p>

        <div id="download" class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center lg:justify-start gap-4 scroll-mt-24">
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener"
            aria-label="Download One Sudoku on the App Store"
            data-store="ios"
            class="w-full sm:w-auto inline-flex items-center justify-center sm:justify-start gap-3 bg-white hover:bg-green-50 text-green-950 font-semibold px-6 py-3.5 rounded-2xl transition-colors shadow-lg shadow-green-950/40"
          >
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
            </svg>
            <span class="text-left">
              <span class="block text-xs text-green-800/60 leading-none mb-0.5">Download on the</span>
              <span class="block text-base leading-none">App Store</span>
            </span>
          </a>
          <a
            href={PLAY_STORE_URL}
            target="_blank"
            rel="noopener"
            aria-label="Get One Sudoku on Google Play"
            data-store="android"
            class="w-full sm:w-auto inline-flex items-center justify-center sm:justify-start gap-3 bg-white hover:bg-green-50 text-green-950 font-semibold px-6 py-3.5 rounded-2xl transition-colors shadow-lg shadow-green-950/40"
          >
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
            </svg>
            <span class="text-left">
              <span class="block text-xs text-green-800/60 leading-none mb-0.5">Get it on</span>
              <span class="block text-base leading-none">Google Play</span>
            </span>
          </a>
          <span class="text-green-300/70 text-sm font-medium">Free · No account required</span>
        </div>
      </div>

      <!-- Real home screen, cropped out of the App Store artwork -->
      <img
        src="/screenshots/home.webp"
        alt={screenshots[0].alt}
        width="720"
        height="1516"
        fetchpriority="high"
        decoding="async"
        class="w-56 sm:w-64 lg:w-72 shrink-0 drop-shadow-2xl"
      />
    </div>
  </section>

  <!-- Trust row -->
  <section class="bg-green-900 px-6 py-8 sm:py-10 border-t border-green-800/40">
    <ul class="max-w-5xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-7">
      {trustPoints.map((point) => (
        <li class="flex gap-3">
          <svg class="w-5 h-5 text-green-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          <div>
            <p class="text-white font-semibold text-sm leading-snug">{point.label}</p>
            <p class="text-green-300/60 text-xs sm:text-sm leading-snug mt-0.5">{point.sub}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Haunted Manor: the Halloween game on the Play hub -->
  <section class="bg-[#17142A] py-16 sm:py-24 px-6 overflow-hidden">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 bg-[#F28C28]/15 border border-[#F28C28]/40 rounded-full px-4 py-1.5 mb-6 text-[#F28C28] text-xs sm:text-sm font-semibold">
          <span class="w-2 h-2 bg-[#F28C28] rounded-full animate-pulse"></span>
          New for Halloween
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#EEE8F6] mb-4">Haunted Manor</h2>
        <p class="text-[#B8B0D2] text-lg leading-relaxed mb-6 max-w-xl mx-auto lg:mx-0">
          A spooky logic puzzle that lives right next to your sudoku. Hide one ghost on every floor, in every hall and in every room — and no two ghosts may touch, not even diagonally.
        </p>
        <ul class="space-y-3 text-[#DDD5EC] text-left max-w-md mx-auto lg:mx-0">
          <li class="flex gap-3"><span class="text-[#F28C28] font-bold" aria-hidden="true">✓</span>Three sizes: Cottage, Manor, and Castle</li>
          <li class="flex gap-3"><span class="text-[#F28C28] font-bold" aria-hidden="true">✓</span>Solvable by logic alone, never by guessing</li>
          <li class="flex gap-3"><span class="text-[#F28C28] font-bold" aria-hidden="true">✓</span>No timer, no rush — hints point to your next step</li>
        </ul>
        <a href="/blog/haunted-manor-ghost-puzzle/" class="inline-flex items-center gap-2 mt-8 text-[#F28C28] hover:text-[#F5A65B] font-semibold transition-colors">
          How to solve Haunted Manor
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mx-auto w-full max-w-xs sm:max-w-sm" role="img" aria-label="A solved 6×6 Haunted Manor: six coloured rooms, each holding one ghost.">
        <div class="grid grid-cols-6 gap-1 p-2 rounded-3xl bg-[#0F0D1C] shadow-2xl shadow-black/40">
          {manorCells.map((cell) => (
            <div class="aspect-square rounded-md flex items-center justify-center" style={`background-color: ${cell.color}`}>
              {cell.ghost && (
                <svg class="w-3/5 h-3/5 drop-shadow" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#F4EEF8" d="M12 2a8 8 0 0 0-8 8v11.5l2.7-2 2.6 2 2.7-2 2.7 2 2.6-2 2.7 2V10a8 8 0 0 0-8-8z"/>
                  <circle cx="9.3" cy="10.5" r="1.4" fill="#17142A"/>
                  <circle cx="14.7" cy="10.5" r="1.4" fill="#17142A"/>
                </svg>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-green-50 py-16 sm:py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-4">Built for sudoku lovers</h2>
        <p class="text-zinc-500 text-lg max-w-xl mx-auto">Every detail is designed to keep you focused on what matters — solving the puzzle.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Classic Rules -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="14" y="3" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="3" y="14" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="14" y="14" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Classic, Killer &amp; Rescue</h3>
          <p class="text-zinc-500 leading-relaxed">Classic 9×9 from Easy to Expert, Killer's sum cages, and Rescue, where you take over a badly solved puzzle and save it.</p>
        </div>

        <!-- Daily Challenge -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Daily Challenge</h3>
          <p class="text-zinc-500 leading-relaxed">A fresh puzzle every day, the same for every player worldwide. Build your streak one solve at a time.</p>
        </div>

        <!-- Clean Design -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Clean, minimal design</h3>
          <p class="text-zinc-500 leading-relaxed">Thoughtful ad placement that stays out of your way — no pop-ups, no forced sign-ups.</p>
        </div>

        <!-- Offline -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-4.9-6H7a4 4 0 00-4 4z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Unlimited offline play</h3>
          <p class="text-zinc-500 leading-relaxed">Puzzles are generated on your device. Play anywhere — on a plane, underground, or off the grid — no connection needed.</p>
        </div>

        <!-- Smart Tools -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Smart solving tools</h3>
          <p class="text-zinc-500 leading-relaxed">Candidate notes, unlimited undo, and auto-save. Every tool you need, and nothing you don't.</p>
        </div>

        <!-- Stats -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V9m6 10V5m6 14v-7"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Track your progress</h3>
          <p class="text-zinc-500 leading-relaxed">Best times, win rate, and streaks across every difficulty. Sign in with Google, Apple, or email if you want it synced across your devices — entirely optional.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- A look inside -->
  <section class="bg-white py-16 sm:py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-4">A look inside</h2>
        <p class="text-zinc-500 text-lg max-w-xl mx-auto">The same clean interface on iPhone, iPad, and Android.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="justify-self-center lg:justify-self-end">
          <img
            src={screenshots[0].src}
            alt={screenshots[0].alt}
            width="720"
            height="1516"
            loading="lazy"
            decoding="async"
            class="w-60 sm:w-72 drop-shadow-2xl"
          />
        </div>

        <ul class="space-y-6 max-w-md">
          {insidePoints.map((point) => (
            <li class="flex gap-4">
              <span class="shrink-0 w-9 h-9 rounded-xl bg-green-100 grid place-items-center">
                <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              <div>
                <h3 class="text-lg font-semibold text-green-950 mb-1">{point.title}</h3>
                <p class="text-zinc-500 leading-relaxed">{point.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How to Play -->
  <section id="how-to-play" class="bg-white pb-16 sm:pb-24 px-6 scroll-mt-20">
    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="text-green-600 font-semibold text-sm tracking-wide uppercase mb-3">How to play</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-5">The rules of sudoku, in one minute</h2>
          <p class="text-zinc-500 text-lg leading-relaxed mb-8">
            Sudoku is a logic puzzle played on a 9×9 grid divided into nine 3×3 boxes. Some numbers are filled in to start — your job is to complete the rest using reasoning alone. No math required.
          </p>
          <ol class="space-y-5">
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-700 font-semibold grid place-items-center">1</span>
              <p class="text-zinc-600 leading-relaxed pt-1">Fill every <strong class="text-green-950 font-semibold">row</strong> with the numbers 1 to 9 — each used exactly once.</p>
            </li>
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-700 font-semibold grid place-items-center">2</span>
              <p class="text-zinc-600 leading-relaxed pt-1">Fill every <strong class="text-green-950 font-semibold">column</strong> with 1 to 9 — no number may repeat.</p>
            </li>
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-700 font-semibold grid place-items-center">3</span>
              <p class="text-zinc-600 leading-relaxed pt-1">Fill every <strong class="text-green-950 font-semibold">3×3 box</strong> with 1 to 9, again with no repeats.</p>
            </li>
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-700 font-semibold grid place-items-center">4</span>
              <p class="text-zinc-600 leading-relaxed pt-1">When the whole grid is filled with no conflicts, the puzzle is solved. Use <strong class="text-green-950 font-semibold">notes</strong> to track candidates as you go.</p>
            </li>
          </ol>
          <p class="mt-8">
            <a href="/blog/learn-sudoku/" class="inline-flex items-center gap-2 text-green-700 hover:text-green-600 font-semibold transition-colors">
              Learn the techniques, from Easy to Expert
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </p>
        </div>

        <!-- mini illustrative grid -->
        <div class="justify-self-center w-full max-w-72" aria-hidden="true">
          <div class="w-full aspect-square p-2 bg-green-50 rounded-2xl border border-green-100 grid grid-cols-9 gap-px">
            {howToCells.map(({ num, cls }) => (
              <div class={cls}>{num || '0'}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-green-50 py-16 sm:py-24 px-6 scroll-mt-20">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-green-950 mb-4">Frequently asked questions</h2>
        <p class="text-zinc-500 text-lg">Everything you might want to know before you download.</p>
      </div>

      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group bg-white rounded-2xl border border-green-100 open:border-green-300 transition-colors">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 sm:px-6 py-5 text-green-950 font-semibold">
              {f.q}
              <svg class="w-5 h-5 text-green-500 shrink-0 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
              </svg>
            </summary>
            <p class="px-5 sm:px-6 pb-5 -mt-1 text-zinc-500 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-green-900 py-16 sm:py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-5">Ready to play?</h2>
      <p class="text-green-200/70 text-lg mb-8 sm:mb-10">Download One Sudoku free and start solving today — no account required, no catch.</p>
      <div class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-4">
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener"
          aria-label="Download One Sudoku on the App Store"
          data-store="ios"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl text-lg transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
          </svg>
          App Store
        </a>
        <a
          href={PLAY_STORE_URL}
          target="_blank"
          rel="noopener"
          aria-label="Get One Sudoku on Google Play"
          data-store="android"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl text-lg transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
          </svg>
          Google Play
        </a>
      </div>
    </div>
  </section>

  <Footer active="home" />

  <!-- Persistent download prompt on phones, where the hero CTAs scroll away fast.
       Sends people to the hero's store buttons rather than guessing their platform. -->
  <div class="sm:hidden h-20" aria-hidden="true"></div>
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-green-950/95 backdrop-blur-sm border-t border-green-800/50 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] flex items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-white font-semibold text-sm leading-tight">One Sudoku</p>
      <p class="text-green-300/70 text-xs leading-tight">Free · No account required</p>
    </div>
    <a href="#download" class="shrink-0 bg-green-500 hover:bg-green-400 text-green-950 font-semibold text-sm px-5 py-2.5 rounded-full transition-colors">
      Download
    </a>
  </div>
</Layout>
