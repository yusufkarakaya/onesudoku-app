---
import Layout from '../layouts/Layout.astro';

const presetNums: Record<number, number> = {
  0:5, 4:3, 7:8, 9:6, 11:1, 15:4, 17:2, 20:8, 23:6,
  27:4, 30:7, 35:9, 36:1, 40:5, 44:3, 45:9, 50:2, 53:6,
  57:3, 61:4, 63:5, 65:8, 69:1, 71:7, 73:7, 76:6, 80:4,
};

const gridCells = Array.from({ length: 81 }, (_, i) => {
  const row = Math.floor(i / 9);
  const col = i % 9;
  const num = presetNums[i];
  const classes = [
    'flex items-center justify-center text-xs font-semibold rounded-sm bg-green-900/20',
    col === 3 || col === 6 ? 'border-l-2 border-l-green-600/50' : '',
    row === 3 || row === 6 ? 'border-t-2 border-t-green-600/50' : '',
    num ? 'text-green-300' : 'text-green-900/30',
  ].filter(Boolean).join(' ');
  return { num, classes };
});

// Update this URL once the App Store listing is live
const APP_STORE_URL = 'https://apps.apple.com/us/app/one-sudoku-game/id6775040739';
---

<Layout>
  <!-- Navbar -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-green-950/90 backdrop-blur-sm border-b border-green-800/30">
    <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-white font-semibold text-xl tracking-tight">
        one sudoku<span class="text-green-400">.</span>
      </a>
      <a
        href={APP_STORE_URL}
        target="_blank"
        class="bg-green-500 hover:bg-green-400 text-green-950 font-semibold text-sm px-5 py-2 rounded-full transition-colors"
      >
        Download
      </a>
    </nav>
  </header>

  <!-- Hero -->
  <section class="bg-green-950 pt-32 pb-24 px-6 overflow-hidden relative">
    <div class="absolute inset-0 opacity-5" style="background-image: repeating-linear-gradient(0deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #4ade80 0, #4ade80 1px, transparent 1px, transparent 40px);"></div>

    <div class="max-w-5xl mx-auto relative flex items-center justify-between gap-12">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-green-900/60 border border-green-700/40 rounded-full px-4 py-1.5 mb-8">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-green-300 text-sm font-medium">Available on iOS</span>
        </div>

        <h1 class="text-6xl md:text-7xl font-bold text-white leading-tight mb-6">
          Sudoku.<br/>
          <span class="text-green-400">Pure and simple.</span>
        </h1>

        <p class="text-green-200/70 text-lg md:text-xl leading-relaxed mb-10 max-w-xl">
          Four difficulty levels, daily challenges, and offline play — all in a clean interface that gets out of your way.
        </p>

        <a
          href={APP_STORE_URL}
          target="_blank"
          class="inline-flex items-center gap-3 bg-white hover:bg-green-50 text-green-950 font-semibold px-6 py-3.5 rounded-2xl transition-colors"
        >
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
          </svg>
          <div class="text-left">
            <div class="text-xs text-green-800/60 leading-none mb-0.5">Download on the</div>
            <div class="text-base leading-none">App Store</div>
          </div>
        </a>
      </div>

      <!-- Abstract Sudoku Grid -->
      <div class="hidden lg:block opacity-60 shrink-0 select-none" aria-hidden="true">
        <div class="w-72 h-72 p-3 bg-green-900/40 rounded-3xl border border-green-700/30 grid grid-cols-9 gap-0.5">
          {gridCells.map(({ num, classes }) => (
            <div class={classes}>{num || '·'}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-green-50 py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-green-950 mb-4">Built for sudoku lovers</h2>
        <p class="text-zinc-500 text-lg max-w-xl mx-auto">Every detail designed to keep you focused on what matters — solving the puzzle.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Classic Rules -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="14" y="3" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="3" y="14" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="14" y="14" width="7" height="7" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Classic Rules</h3>
          <p class="text-zinc-500 leading-relaxed">Standard 9×9 grid with four difficulty levels — Easy, Medium, Hard, and Expert.</p>
        </div>

        <!-- Daily Challenge -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Daily Challenge</h3>
          <p class="text-zinc-500 leading-relaxed">A fresh puzzle every day, the same for every player worldwide. Build your streak.</p>
        </div>

        <!-- Clean Design -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Clean Design</h3>
          <p class="text-zinc-500 leading-relaxed">Minimal interface with light and dark themes. No banners, no pop-ups, no interruptions.</p>
        </div>

        <!-- Offline -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-4.9-6H7a4 4 0 00-4 4z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Fully Offline</h3>
          <p class="text-zinc-500 leading-relaxed">Unlimited puzzles generated on-device. Play anywhere — no internet connection needed.</p>
        </div>

        <!-- Smart Tools -->
        <div class="bg-white rounded-3xl p-8 border border-green-100 hover:border-green-300 transition-colors">
          <div class="w-12 h-12 bg-green-100 rounded-2xl flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-green-950 mb-2">Smart Tools</h3>
          <p class="text-zinc-500 leading-relaxed">Candidate notes, unlimited undo, and auto-save. Every tool you need, nothing you don't.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-green-900 py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-5">Ready to play?</h2>
      <p class="text-green-200/70 text-lg mb-10">Download One Sudoku for free and start solving today.</p>
      <a
        href={APP_STORE_URL}
        class="inline-flex items-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl text-lg transition-colors"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
        </svg>
        Download on the App Store
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-green-950 py-10 px-6">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-white font-semibold text-lg">
        one sudoku<span class="text-green-400">.</span>
      </span>
      <div class="flex items-center gap-6 text-sm">
        <a href="/privacy" class="text-green-400/60 hover:text-green-400 transition-colors">Privacy Policy</a>
        <a href="/support" class="text-green-400/60 hover:text-green-400 transition-colors">Support</a>
      </div>
      <p class="text-green-400/40 text-sm">© {new Date().getFullYear()} onesudoku.co · All rights reserved.</p>
    </div>
  </footer>
</Layout>
