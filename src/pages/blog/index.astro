---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'Blog — One Sudoku';
const description =
  'Writing about sudoku: how the puzzle works, the techniques worth learning, and what a daily solve is actually good for.';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'One Sudoku Blog',
  description,
  url: `${SITE_URL}/blog/`,
  publisher: {
    '@type': 'Organization',
    name: 'One Sudoku',
    url: SITE_URL,
    logo: `${SITE_URL}/logo-512.png`,
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: `${SITE_URL}/blog/${post.id}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'One Sudoku', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
  ],
};

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header variant="sub" />

  <main class="bg-white">
    <section class="bg-green-950 px-6 py-14 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <span class="inline-block bg-green-900/60 border border-green-700/40 text-green-300 text-xs font-semibold px-3 py-1 rounded-full mb-4">Blog</span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4">Notes on sudoku</h1>
        <p class="text-green-200/70 text-lg leading-relaxed max-w-xl">{description}</p>
      </div>
    </section>

    <section class="px-6 py-12 sm:py-16 min-h-[40vh]">
      <div class="max-w-3xl mx-auto">
        {posts.length === 0 ? (
          <p class="text-zinc-500">No posts yet — check back soon.</p>
        ) : (
          <ul class="space-y-5">
            {posts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}/`}
                  class="block bg-white rounded-3xl border border-green-100 hover:border-green-300 hover:shadow-lg hover:shadow-green-100/60 transition-all p-6 sm:p-8"
                >
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-400 mb-3">
                    <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
                    {post.data.readingTime && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{post.data.readingTime} min read</span>
                      </>
                    )}
                  </div>
                  <h2 class="text-xl sm:text-2xl font-bold text-green-950 mb-2 leading-snug">{post.data.title}</h2>
                  <p class="text-zinc-500 leading-relaxed mb-4">{post.data.description}</p>
                  <span class="inline-flex items-center gap-2 text-green-700 font-semibold text-sm">
                    Read the post
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>

  <Footer active="blog" />
</Layout>
