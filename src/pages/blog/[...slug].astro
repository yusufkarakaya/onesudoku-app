---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, APP_STORE_URL, PLAY_STORE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, readingTime } = post.data;

const url = `${SITE_URL}/blog/${post.id}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: `${SITE_URL}/og-image.png`,
  author: { '@type': 'Organization', name: 'One Sudoku', url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'One Sudoku',
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/logo-512.png` },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'One Sudoku', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={`${title} — One Sudoku`} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header variant="sub" />

  <main class="bg-white">
    <article>
      <header class="bg-green-950 px-6 py-12 sm:py-16">
        <div class="max-w-2xl mx-auto">
          <nav class="mb-6" aria-label="Breadcrumb">
            <a href="/blog/" class="inline-flex items-center gap-2 text-green-400/70 hover:text-green-400 text-sm font-medium transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
              </svg>
              All posts
            </a>
          </nav>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight mb-5">{title}</h1>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-green-300/60">
            <time datetime={pubDate.toISOString()}>{dateFormat.format(pubDate)}</time>
            {readingTime && (
              <>
                <span aria-hidden="true">·</span>
                <span>{readingTime} min read</span>
              </>
            )}
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated {dateFormat.format(updatedDate)}</span>
              </>
            )}
          </div>
        </div>
      </header>

      <div class="px-6 py-12 sm:py-16">
        <div
          class="max-w-2xl mx-auto prose prose-zinc prose-lg
                 prose-headings:text-green-950 prose-headings:font-bold
                 prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-12 prose-h2:mb-4
                 prose-p:text-zinc-600 prose-li:text-zinc-600
                 prose-strong:text-green-950
                 prose-a:text-green-700 prose-a:font-semibold hover:prose-a:text-green-600
                 prose-hr:border-green-100"
        >
          <Content />
        </div>
      </div>
    </article>

    <!-- Post-read CTA -->
    <section class="bg-green-900 px-6 py-14 sm:py-20">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Try today's puzzle</h2>
        <p class="text-green-200/70 text-lg mb-8">One Sudoku is free, works offline, and doesn't ask you to make an account.</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-4">
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener"
            aria-label="Download One Sudoku on the App Store"
            data-store="ios"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl transition-colors"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/>
            </svg>
            App Store
          </a>
          <a
            href={PLAY_STORE_URL}
            target="_blank"
            rel="noopener"
            aria-label="Get One Sudoku on Google Play"
            data-store="android"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-green-400 hover:bg-green-300 text-green-950 font-semibold px-8 py-4 rounded-2xl transition-colors"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.609 22.186a2.01 2.01 0 0 1-.61-1.437V3.251c0-.56.24-1.064.61-1.437zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626c.68.394.68 1.378 0 1.772l-2.807 1.626-2.494-2.512 2.494-2.512zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
            </svg>
            Google Play
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer active="blog" />
</Layout>
