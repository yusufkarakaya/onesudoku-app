---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'How do I play sudoku?',
    a: 'Fill the 9×9 grid so that every row, column, and 3×3 box contains the digits 1–9 exactly once. Tap an empty cell to select it, then tap a number from the panel to fill it in. Use pencil mode to jot down candidate numbers without committing to an answer.',
  },
  {
    q: 'What difficulty levels are available?',
    a: 'One Sudoku offers four levels: Easy, Medium, Hard, and Expert. Easy puzzles have more given numbers and are great for beginners. Expert puzzles require advanced techniques and are suited for experienced solvers.',
  },
  {
    q: 'How do I use notes / pencil mode?',
    a: 'Tap the pencil icon in the toolbar to toggle notes mode. In notes mode, tapping a number adds it as a small candidate note inside the cell without committing it as a final answer. Toggle back to normal mode to enter final answers.',
  },
  {
    q: 'How do I undo a move?',
    a: 'Tap the undo button (↩) in the toolbar to step back one move at a time. You can undo as many times as you like.',
  },
  {
    q: 'What is the Daily Challenge?',
    a: 'A fresh puzzle is available every day — the same puzzle for every player worldwide. Completing it extends your daily streak. Miss a day and your streak resets.',
  },
  {
    q: 'Is my progress backed up?',
    a: 'Your game data is stored locally on your device. If you have iCloud Backup enabled in iOS Settings, your data is included in your backup and will be restored when you reinstall the app or switch to a new device.',
  },
  {
    q: 'What languages does the app support?',
    a: 'One Sudoku is only available in English.',
  },
  {
    q: 'How do I reset my progress?',
    a: 'Go to Settings (gear icon) inside the app and tap "Reset All Progress". This clears all statistics, streaks, and completed puzzles. This action cannot be undone.',
  },
  {
    q: 'Does the app work offline?',
    a: 'Yes. Puzzles are generated on-device, so you can play anywhere without an internet connection.',
  },
  {
    q: 'Does the app have ads?',
    a: 'Yes, One Sudoku shows small banner ads at the bottom of the screen to keep the app free. You may also see a short ad after completing a puzzle. Additionally, you can choose to watch a video ad to earn extra hints — this is entirely optional.',
  },
];
---

<Layout title="Support — One Sudoku" description="Get help with the One Sudoku iOS app.">
  <!-- Navbar -->
  <header class="bg-green-950 border-b border-green-800/30">
    <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-white font-semibold text-xl tracking-tight">
        one sudoku<span class="text-green-400">.</span>
      </a>
      <a href="/privacy" class="text-green-400/60 hover:text-green-400 text-sm transition-colors">Privacy</a>
    </nav>
  </header>

  <main class="min-h-screen bg-white">
    <!-- Hero -->
    <section class="bg-green-50 py-16 px-6 border-b border-green-100">
      <div class="max-w-2xl mx-auto text-center">
        <span class="inline-block bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full mb-4">Help Center</span>
        <h1 class="text-4xl font-bold text-green-950 mb-4">Support</h1>
        <p class="text-zinc-500 text-lg">
          Find answers to common questions below. Can't find what you need? Drop us an email.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 px-6">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-green-950 mb-8">Frequently Asked Questions</h2>

        <div class="space-y-3">
          {faqs.map(({ q, a }) => (
            <details class="group border border-green-100 rounded-2xl overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer select-none text-green-950 font-medium hover:bg-green-50 transition-colors list-none">
                <span>{q}</span>
                <svg class="w-4 h-4 text-green-500 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-5 text-zinc-600 leading-relaxed border-t border-green-100 pt-4">
                {a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="py-16 px-6 bg-green-950">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Still need help?</h2>
        <p class="text-green-200/70 text-lg mb-8">
          Send us an email and we'll get back to you as soon as possible.
        </p>
        <a
          href="mailto:yusufkarakaya92@gmail.com"
          class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-green-950 font-semibold px-8 py-4 rounded-2xl text-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          yusufkarakaya92@gmail.com
        </a>
        <p class="text-green-400/40 text-sm mt-6">We typically respond within 1–2 business days.</p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-green-950 py-10 px-6 border-t border-green-800/30">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="/" class="text-white font-semibold text-lg">
        one sudoku<span class="text-green-400">.</span>
      </a>
      <div class="flex items-center gap-6 text-sm">
        <a href="/privacy" class="text-green-400/60 hover:text-green-400 transition-colors">Privacy Policy</a>
        <a href="/support" class="text-green-400 transition-colors">Support</a>
      </div>
      <p class="text-green-400/40 text-sm">© {new Date().getFullYear()} onesudoku.co · All rights reserved.</p>
    </div>
  </footer>
</Layout>
