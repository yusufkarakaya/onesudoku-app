---
import BlogIndexPage from '../../../components/blog/BlogIndexPage.astro';
import { PREFIXED_LANGS, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BlogIndexPage lang={lang} />
