---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'One Sudoku — Classic Sudoku for iPhone & iPad',
  description = 'A clean, distraction-free sudoku experience. Four difficulty levels, daily puzzles, and offline play — all on iPhone and iPad.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://www.onesudoku.co/" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.onesudoku.co/" />
    <meta property="og:site_name" content="One Sudoku" />

    <!-- Apple -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="font-sans antialiased bg-white text-zinc-900">
    <slot />
  </body>
</html>

<style>
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
