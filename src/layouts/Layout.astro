---
import '../styles/global.css';
import SiteAnalytics from '../components/Analytics.astro';
import { SITE_URL } from '../consts';
import { DEFAULT_LANG, LANG_META, type Alternate, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: Lang;
  /** Every language version of this page, this one included. Drives hreflang. */
  alternates?: Alternate[];
}

const {
  title = 'One Sudoku — Offline Sudoku App for iPhone & Android',
  description = 'One Sudoku is a free sudoku app for iPhone, iPad, and Android. Play offline with no Wi‑Fi: Classic, Killer, and Rescue sudoku, one new puzzle a day, and dark mode. No account needed, ad-free with Premium.',
  image = '/og-image.png',
  noindex = false,
  lang = DEFAULT_LANG,
  alternates = [],
} = Astro.props;

// hreflang only means something when there is more than one version.
const hreflangs = alternates.length > 1 ? alternates : [];
const xDefault = hreflangs.find((a) => a.lang === DEFAULT_LANG);

const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#052e16" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, siteUrl).href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, siteUrl).href} />}
    <link rel="alternate" type="application/rss+xml" title="One Sudoku Blog" href="/rss.xml" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="One Sudoku" />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {hreflangs.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={LANG_META[a.lang].ogLocale} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="One Sudoku — an offline sudoku app for iPhone, iPad, and Android" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apple -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="One Sudoku" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <SiteAnalytics />

    <slot name="head" />

    <title>{title}</title>
  </head>
  <body class="font-sans antialiased bg-white text-zinc-900">
    <slot />
  </body>
</html>

<style>
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
