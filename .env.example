# GA4 Measurement ID. Without it, no analytics script is emitted at all.
# Astro inlines PUBLIC_* at build time, so changing this in Netlify
# (Site configuration → Environment variables) needs a new deploy.
PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the `content` value only).
# Leave empty if the domain is verified by DNS TXT record instead.
PUBLIC_GSC_VERIFICATION=

# Google AdSense for /play. Leave empty until the site is approved — with no
# client id, no ad script is loaded and every ad slot renders nothing.
# Same publisher as AdMob: ca-pub-2553778273795539 (public/ads.txt lists it).
PUBLIC_ADSENSE_CLIENT=
# Ad unit ids from AdSense → Ads → By ad unit. Any slot left empty is skipped.
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_BELOW_BOARD=
PUBLIC_ADSENSE_SLOT_CONTENT=
PUBLIC_ADSENSE_SLOT_COMPLETE=
